        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 500,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Ти класифікуєш вхідні відповіді від контент-креаторів на пропозиції про співпрацю.\\n\\nЛист від: {{ $json.From }}\\nТема: {{ $json.Subject }}\\nТекст:\\n{{ $json.snippet }}\\n\\nПоверни ТІЛЬКИ валідний JSON без markdown-обгортки, без пояснень:\\n{\\n  \\\"category\\\": одне з: interested | negotiating | declined | question | spam,\\n  \\\"priority\\\": одне з: high | medium | low,\\n  \\\"creator_name\\\": ім'я або нік креатора, якщо видно, інакше \\\"unknown\\\",\\n  \\\"summary\\\": одне речення українською, суть повідомлення,\\n  \\\"key_points\\\": масив рядків, конкретика — названі ціни, дедлайни, умови, питання\\n}\\n\\nПравила пріоритету:\\n- high: креатор готовий домовлятись, назвав ціну, або поставив питання що блокує угоду\\n- medium: цікавиться, але без конкретики\\n- low: відмова, спам, автовідповідь\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        224,
        0
      ],
      "id": "31d15c32-b971-4ce5-82b3-b4547c993f13",
      "name": "HTTP Request",
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.content[0].text;\n\nconst cleaned = raw.replace(/```json\\n?/g, '').replace(/```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    category: 'question',\n    priority: 'medium',\n    creator_name: 'unknown',\n    summary: 'PARSE FAILED: ' + raw.slice(0, 200),\n    key_points: []\n  };\n}\n\nconst email = $('Gmail Trigger').first().json;\n\nconst fromRaw = email.From ?? '';\nconst fromAddress = fromRaw.match(/<(.+?)>/)?.[1] ?? fromRaw;\n\nreturn [{\n  json: {\n    ...parsed,\n    from: fromAddress,\n    subject: email.Subject ?? '',\n    body: email.snippet ?? '',\n    threadId: email.threadId ?? '',\n    date: new Date().toISOString()\n  }\n}];"
      },
